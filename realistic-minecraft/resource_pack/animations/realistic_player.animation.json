{
  "format_version": "1.8.0",
  "animations": {
    "animation.player.move.legs": {
      "loop": true,
      "bones": {
        "leftleg": {
          "rotation": ["variable.rm_leg_l", -0.1, -0.1]
        },
        "rightleg": {
          "rotation": ["variable.rm_leg_r", 0.1, 0.1]
        }
      }
    },
    "animation.player.move.arms": {
      "loop": true,
      "bones": {
        "leftarm": {
          "rotation": ["variable.rm_arm_l", 0.0, "variable.rm_arm_lz"]
        },
        "rightarm": {
          "rotation": ["variable.rm_arm_r", 0.0, "variable.rm_arm_rz"]
        }
      }
    },
    "animation.player.first_person.walk": {
      "loop": true,
      "bones": {
        "leftarm": {
          "position": [
            "math.sin(-query.walk_distance * 180.0) * variable.hand_bob * 9.75",
            "-math.abs(math.cos(-query.walk_distance * 180.0)) * variable.hand_bob * (query.is_sprinting ? 16.5 : 15.0) + variable.short_arm_offset_left - variable.rm_rise * 0.65 + variable.rm_fall * 0.85 - variable.rm_crouch * 0.4",
            "variable.rm_fall * 0.3"
          ]
        },
        "rightarm": {
          "position": [
            "math.sin(-query.walk_distance * 180.0) * variable.hand_bob * 9.75",
            "-math.abs(math.cos(-query.walk_distance * 180.0)) * variable.hand_bob * (query.is_sprinting ? 16.5 : 15.0) + variable.short_arm_offset_right - variable.rm_rise * 0.65 + variable.rm_fall * 0.85 - variable.rm_crouch * 0.4",
            "variable.rm_fall * 0.3"
          ]
        }
      }
    },
    "animation.realistic.player.breathe": {
      "loop": true,
      "bones": {
        "body": {
          "rotation": ["math.sin(query.life_time * 55.0) * 0.7", 0.0, 0.0]
        }
      }
    },
    "animation.realistic.player.lean": {
      "loop": true,
      "bones": {
        "waist": {
          "rotation": [
            "(query.is_sprinting ? -5.0 : -2.0) * math.clamp(query.modified_move_speed, 0.0, 1.0)",
            0.0,
            "math.sin(query.modified_distance_moved * 38.17) * (query.is_sprinting ? 1.4 : 0.8)"
          ]
        }
      }
    },
    "animation.realistic.player.jump": {
      "loop": true,
      "bones": {
        "waist": {
          "rotation": [3.0, 0.0, 0.0]
        }
      }
    },
    "animation.realistic.player.fall": {
      "loop": true,
      "bones": {
        "waist": {
          "rotation": [
            "-math.clamp((-query.position_delta(1)) * 22.0, 0.0, 7.0)",
            0.0,
            0.0
          ]
        }
      }
    },
    "animation.realistic.player.land": {
      "animation_length": 0.34,
      "loop": false,
      "bones": {
        "waist": {
          "rotation": {
            "0.0": [0.0, 0.0, 0.0],
            "0.08": [-4.5, 0.0, 0.0],
            "0.34": [0.0, 0.0, 0.0]
          }
        }
      }
    }
  }
}
