        },
        "obesity:eating": {
          "type": "bool",
          "default": false,
          "client_sync": true
        },
        "obesity:fresh": {
          "type": "bool",
          "default": true,
          "client_sync": true
        }
      }
    },
    "components": {
      "minecraft:type_family": {
        "family": ["obesity", "mob"]
      },
      "minecraft:breathable": {
        "total_supply": 15,
        "suffocate_time": 0
      },
      "minecraft:health": {
        "value": 40,
        "max": 40
      },
      "minecraft:collision_box": {
        "width": 0.9,
        "height": 1.45
      },
      "minecraft:movement": {
