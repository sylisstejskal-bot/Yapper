{
  "format_version": "1.21.90",
  "minecraft:entity": {
    "description": {
      "identifier": "obesity:obesity",
      "is_spawnable": false,
      "is_summonable": true,
      "is_experimental": false,
      "properties": {
        "obesity:hunger": {
          "type": "int",
          "range": [0, 20],
          "default": 14,
          "client_sync": true
        },
        "obesity:eating": {
          "type": "bool",
          "default": false,
          "client_sync": true
        },
        "obesity:fresh": {
          "type": "bool",
          "default": true,
          "client_sync": true
        }
      }
    },
    "components": {
      "minecraft:type_family": {
        "family": ["obesity", "mob"]
      },
      "minecraft:breathable": {
        "total_supply": 15,
        "suffocate_time": 0
      },
      "minecraft:health": {
        "value": 40,
        "max": 40
      },
      "minecraft:collision_box": {
        "width": 1.05,
        "height": 1.3
      },
      "minecraft:movement": {
        "value": 0.14
      },
      "minecraft:movement.basic": {},
      "minecraft:navigation.walk": {
        "can_path_over_water": true,
        "avoid_water": true,
        "avoid_damage_blocks": true,
        "can_pass_doors": true,
        "can_walk": true
      },
      "minecraft:jump.static": {
        "jump_power": 0.42
      },
      "minecraft:physics": {},
      "minecraft:pushable": {
        "is_pushable": true,
        "is_pushable_by_piston": true
      },
      "minecraft:knockback_resistance": {
        "value": 0.7
      },
      "minecraft:damage_sensor": {
        "triggers": [
          {
            "cause": "fall",
            "deals_damage": false
          }
        ]
      },
      "minecraft:persistent": {},
      "minecraft:nameable": {
        "always_show": true,
        "allow_name_tag_renaming": false
      },
      "minecraft:tameable": {
        "probability": 1.0,
        "tame_items": ["minecraft:bedrock"]
      },
      "minecraft:behavior.float": {
        "priority": 0
      },
      "minecraft:behavior.follow_owner": {
        "priority": 3,
        "speed_multiplier": 1.05,
        "start_distance": 3,
        "stop_distance": 1.6
      },
      "minecraft:behavior.look_at_player": {
        "priority": 7,
        "look_distance": 8,
        "probability": 0.6
      },
      "minecraft:behavior.random_look_around": {
        "priority": 8
      },
      "minecraft:interact": {
        "interactions": [
          {
            "on_interact": {
              "filters": {
                "test": "is_family",
                "subject": "other",
                "value": "player"
              },
              "event": "obesity:pat",
              "target": "self"
            },
            "interact_text": "action.interact.feed",
            "swing": true
          }
        ]
      }
    },
    "events": {
      "obesity:pat": {
        "set_property": {
          "obesity:fresh": "query.property('obesity:fresh')"
        }
      }
    }
  }
}
