        "interactions": [
          {
            "on_interact": {
              "filters": {
                "test": "is_family",
                "subject": "other",
                "value": "player"
              },
              "event": "obesity:pat",
              "target": "self"
            },
            "interact_text": "action.interact.feed",
            "swing": true
          }
